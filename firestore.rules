rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateKey(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidPuzzleType(val) {
      return val is string && val in ['sudoku', 'crossword', 'wordsearch'];
    }

    function isValidDifficulty(val) {
      return val is string && val in ['easy', 'medium', 'hard'];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'userId',
        'displayName',
        'currentStreak',
        'bestStreak',
        'lastSolvedDate',
        'totalSolved',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'userId',
        'displayName',
        'currentStreak',
        'bestStreak',
        'lastSolvedDate',
        'totalSolved',
        'poxBalance',
        'createdAt',
        'updatedAt'
      ])
      && data.userId is string && data.userId == userId && data.userId == request.auth.uid
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
      && data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000
      && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 10000
      && data.bestStreak >= data.currentStreak
      && data.lastSolvedDate is string && data.lastSolvedDate.size() <= 10
      && (data.lastSolvedDate == '' || isValidDateKey(data.lastSolvedDate))
      && data.totalSolved is int && data.totalSolved >= 0 && data.totalSolved <= 100000
      && (!('poxBalance' in data) || (data.poxBalance is int && data.poxBalance >= 0 && data.poxBalance <= 1000000))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidDailyCompletion(data, userId, completionId) {
      return data.keys().hasAll([
        'userId',
        'dateKey',
        'puzzleType',
        'timeSeconds',
        'mistakes',
        'completed',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'userId',
        'dateKey',
        'puzzleType',
        'difficulty',
        'timeSeconds',
        'mistakes',
        'completed',
        'createdAt'
      ])
      && data.userId is string && data.userId == userId && data.userId == request.auth.uid
      && isValidDateKey(data.dateKey)
      && isValidPuzzleType(data.puzzleType)
      && (!('difficulty' in data) || isValidDifficulty(data.difficulty))
      && completionId == data.dateKey + '_' + data.puzzleType
      && data.timeSeconds is int && data.timeSeconds >= 1 && data.timeSeconds <= 86400
      && data.mistakes is int && data.mistakes >= 0 && data.mistakes <= 1000
      && data.completed is bool && data.completed == true
      && data.createdAt is timestamp;
    }

    function isValidPurchasedPuzzle(data, userId, puzzleId) {
      return data.keys().hasAll([
        'id',
        'userId',
        'puzzleType',
        'difficulty',
        'title',
        'seedKey',
        'themeIndex',
        'customTheme',
        'customWords',
        'costPox',
        'solved',
        'bestTimeSeconds',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'userId',
        'puzzleType',
        'difficulty',
        'title',
        'seedKey',
        'themeIndex',
        'customTheme',
        'customWords',
        'costPox',
        'solved',
        'bestTimeSeconds',
        'createdAt',
        'updatedAt'
      ])
      && data.id is string && data.id == puzzleId && data.id.size() >= 1 && data.id.size() <= 64
      && data.userId is string && data.userId == userId && data.userId == request.auth.uid
      && isValidPuzzleType(data.puzzleType)
      && isValidDifficulty(data.difficulty)
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 60
      && data.seedKey is string && data.seedKey.size() >= 1 && data.seedKey.size() <= 80
      && data.themeIndex is int && data.themeIndex >= 0 && data.themeIndex <= 100
      && data.customTheme is string && data.customTheme.size() <= 40
      && data.customWords is list && data.customWords.size() <= 12
      && (data.customWords.size() == 0 || (data.customWords[0] is string && data.customWords[0].size() <= 16))
      && data.costPox is int && data.costPox == 50
      && data.solved is bool
      && data.bestTimeSeconds is int && data.bestTimeSeconds >= 0 && data.bestTimeSeconds <= 86400
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data, entryId) {
      return data.keys().hasAll([
        'userId',
        'playerName',
        'dateKey',
        'puzzleType',
        'timeSeconds',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'userId',
        'playerName',
        'dateKey',
        'puzzleType',
        'difficulty',
        'timeSeconds',
        'createdAt'
      ])
      && data.userId is string && data.userId == request.auth.uid
      && data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 40
      && isValidDateKey(data.dateKey)
      && isValidPuzzleType(data.puzzleType)
      && (!('difficulty' in data) || isValidDifficulty(data.difficulty))
      && entryId == data.dateKey + '_' + data.puzzleType + '_' + request.auth.uid
      && data.timeSeconds is int && data.timeSeconds >= 1 && data.timeSeconds <= 86400
      && data.createdAt is timestamp;
    }

    // Connection check document (non-sensitive ping)
    match /test/connection {
      allow get: if true;
    }

    // User profile, streaks, and virtual pox balance
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'currentStreak',
          'bestStreak',
          'lastSolvedDate',
          'totalSolved',
          'poxBalance',
          'updatedAt'
        ]);
      allow delete: if false;

      // Immutable daily puzzle completion records (strictly 1 play per puzzle per calendar day)
      match /dailyCompletions/{completionId} {
        allow get: if isValidId(userId) && isValidId(completionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(completionId)
          && isOwner(userId)
          && isValidDailyCompletion(incoming(), userId, completionId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update, delete: if false;
      }

      // Purchased custom puzzles unlocked with virtual pox (50 pox each)
      match /purchasedPuzzles/{puzzleId} {
        allow get: if isValidId(userId) && isValidId(puzzleId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(puzzleId)
          && isOwner(userId)
          && isValidPurchasedPuzzle(incoming(), userId, puzzleId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(puzzleId)
          && isOwner(userId)
          && isValidPurchasedPuzzle(incoming(), userId, puzzleId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().puzzleType == existing().puzzleType
          && incoming().seedKey == existing().seedKey
          && incoming().costPox == existing().costPox
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'solved',
            'bestTimeSeconds',
            'updatedAt'
          ]);
        allow delete: if false;
      }
    }

    // Public daily leaderboard entries
    match /leaderboardEntries/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if resource.data.dateKey is string;
      allow create: if isVerified()
        && isValidId(entryId)
        && isValidLeaderboardEntry(incoming(), entryId)
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/dailyCompletions/$(incoming().dateKey + '_' + incoming().puzzleType));
      allow update, delete: if false;
    }
  }
}
